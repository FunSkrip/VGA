[Unit]
Description=VGA Flask application
After=network.target

[Service]
Type=simple
User=vga
Group=vga
WorkingDirectory=/opt/vga
EnvironmentFile=/etc/vga/vga.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/vga/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 --timeout 1800 wsgi:app
Restart=on-failure
RestartSec=5

# The service needs to write only to the instance directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The models directory is writable only for admin-triggered official downloads;
# installed weight files are marked read-only by the application.
ReadWritePaths=/opt/vga/app/instance /opt/vga/models

[Install]
WantedBy=multi-user.target
