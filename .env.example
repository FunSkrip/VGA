# Copy to .env for local development. Never commit real secrets.
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional comma-separated old keys kept valid during rotation.
SECRET_KEY_FALLBACKS=

# Optional. Without it the support chatbot is disabled.
GEMINI_API_KEY=

# Session and CSRF live for 30 minutes of inactivity by default.
SESSION_LIFETIME_MINUTES=30
CSRF_TIME_LIMIT_MINUTES=30
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Comma-separated production host names, e.g. vga.example.ru
TRUSTED_HOSTS=

# Enable only when Flask is reachable exclusively through the reverse proxy.
TRUST_PROXY=0
TRUSTED_PROXY_COUNT=1

# HSTS is emitted by Flask only for HTTPS requests. Set 0 to disable.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=0

LOG_LEVEL=INFO
